<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">
  <Id>b6e1f0a2-4c3d-4a2e-9b7a-2f6e9d1c8a55</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Jkubu</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Text Cleaner AI" />
  <Description DefaultValue="Cleans PDF-pasted text in Word: merges broken lines into paragraphs and fixes joined words, using AI." />
  <IconUrl DefaultValue="https://word-text-cleaner-ai.onrender.com/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://word-text-cleaner-ai.onrender.com/icon-80.png" />
  <SupportUrl DefaultValue="https://word-text-cleaner-ai.onrender.com" />

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://word-text-cleaner-ai.onrender.com/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://word-text-cleaner-ai.onrender.com/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://word-text-cleaner-ai.onrender.com/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://word-text-cleaner-ai.onrender.com/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://word-text-cleaner-ai.onrender.com" />
        <bt:Url id="Commands.Url" DefaultValue="https://word-text-cleaner-ai.onrender.com/taskpane.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://word-text-cleaner-ai.onrender.com/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with Text Cleaner AI!" />
        <bt:String id="CommandsGroup.Label" DefaultValue="Text Cleaner" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Clean Text" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Select messy pasted text and click Clean Text to fix broken lines and joined words." />
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Opens the Text Cleaner AI sidebar." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
